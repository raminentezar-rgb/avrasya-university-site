msgstr "وزارة الصحة (كخبير صحي)"

#: .\saglik_yonetimi\templates\saglik_yonetimi\includes\saglik_yonetimi.html:613
msgid "Üniversitelerde akademisyen olarak"
msgstr "كأكاديمي في الجامعات"

#: .\saglik_yonetimi\templates\saglik_yonetimi\includes\saglik_yonetimi.html:614
msgid "Dünya Sağlık Örgütü projeleri"
msgstr "مشاريع منظمة الصحة العالمية"

#: .\saglik_yonetimi\templates\saglik_yonetimi\includes\saglik_yonetimi.html:615
msgid "Kendi işinin yöneticisi"
msgstr "مدير لحسابه الخاص"

#: .\saglik_yonetimi\templates\saglik_yonetimi\includes\saglik_yonetimi.html:626
