#: .\lojistik_programi\templates\lojistik_programi\includes\lojistik_programi.html:371
msgid "Lojistik Mezunları Ne İş Yaparlar?"
msgstr "Was machen Logistik-Absolventen?"

#: .\lojistik_programi\templates\lojistik_programi\includes\lojistik_programi.html:375
msgid ""
"Lojistik programı mezunları, tedarik zinciri yönetiminin tüm aşamalarında "
