msgstr "центр семейного здоровья"

#: .\ebelik\templates\ebelik\includes\ebelik.html:591
msgid "Ana-çocuk sağlığı merkezi"
msgstr "Центр здоровья матери и ребенка"

#: .\ebelik\templates\ebelik\includes\ebelik.html:592
