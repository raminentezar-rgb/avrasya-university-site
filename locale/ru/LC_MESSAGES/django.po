msgstr "Менеджер по транспортным операциям"

#: .\lojistik_programi\templates\lojistik_programi\includes\lojistik_programi.html:587
msgid "Müşteri Hizmetleri Uzmanı"
msgstr "Специалист по обслуживанию клиентов"

#: .\lojistik_programi\templates\lojistik_programi\includes\lojistik_programi.html:588
msgid "Satın Alma Asistanı"
msgstr "Помощник по закупкам"

#: .\lojistik_programi\templates\lojistik_programi\includes\lojistik_programi.html:598
