#: .\ilk_acil_yardim\templates\ilk_acil_yardim\includes\ilk_acil_yardim.html:479
msgid "Acil durumlarda hızlı karar verme becerisi"
msgstr "Умение быстро принимать решения в экстренных ситуациях"

#: .\ilk_acil_yardim\templates\ilk_acil_yardim\includes\ilk_acil_yardim.html:480
msgid "Temel ve ileri yaşam desteği uygulama becerisi"
msgstr "Возможность применять базовую и расширенную систему жизнеобеспечения."

#: .\ilk_acil_yardim\templates\ilk_acil_yardim\includes\ilk_acil_yardim.html:481
