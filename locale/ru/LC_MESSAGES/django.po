#: .\ic_mekan\templates\ic_mekan\includes\ic_mekan.html:574
#: .\ic_mekan\templates\ic_mekan\includes\ic_mekan.html:595
msgid "Teknik çizim hazırlama"
msgstr "Подготовка технических чертежей"

#: .\ic_mekan\templates\ic_mekan\includes\ic_mekan.html:575
msgid "Proje detaylandırma"
msgstr "Детализация проекта"

#: .\ic_mekan\templates\ic_mekan\includes\ic_mekan.html:576
msgid "3D modelleme ve render"
msgstr "3D-моделирование и рендеринг"

#: .\ic_mekan\templates\ic_mekan\includes\ic_mekan.html:577
msgid "Malzeme seçimi ve önerileri"
msgstr "Выбор материала и рекомендации"

#: .\ic_mekan\templates\ic_mekan\includes\ic_mekan.html:578
msgid "Proje takip ve kontrol"
msgstr "Сопровождение и контроль проекта"

#: .\ic_mekan\templates\ic_mekan\includes\ic_mekan.html:591
msgid "Mobilya firmalarının tasarım bölümlerinde çalışabilirler."
msgstr "Они могут работать в дизайнерских отделах мебельных компаний."

