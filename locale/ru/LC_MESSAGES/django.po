#| msgid "Etkinlikler"
msgid "Yetkinlik"
msgstr ""

#: .\anestezi\templates\anestezi\includes\anestezi.html:287
msgid "Anestezi hizmetinde yetkin teknik elemanlar yetiştirmek"
msgstr "Обучить компетентный технический персонал анестезиологической службы."

#: .\anestezi\templates\anestezi\includes\anestezi.html:294
msgid "Tercih Edilen"
msgstr "Предпочтительный"

#: .\anestezi\templates\anestezi\includes\anestezi.html:295
msgid "Kamu ve özel sektörde tercih edilen mezunlar yetiştirmek"
msgstr ""
"Обучать выпускников, которые предпочитаются в государственном и частном "
"секторах."

#: .\anestezi\templates\anestezi\includes\anestezi.html:303
msgid "Etik kurallara bağlı, mesleki değerlere saygılı uzmanlar"
