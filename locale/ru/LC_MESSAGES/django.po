msgid "Endüstriyel İhtiyaçlar"
msgstr "Промышленные нужды"

#: .\elektrik_elektronik_muhendisligi\templates\elektrik_elektronik_muhendisligi\includes\elektrik_elektronik_muhendisligi.html:259
