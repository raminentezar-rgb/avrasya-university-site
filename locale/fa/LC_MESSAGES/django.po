msgstr "وظایف اصلی فارغ التحصیلان رشته مدیریت ورزشی"

#: .\spor_yonetimi\templates\spor_yonetimi\includes\spor_yonetimi.html:418
msgid "Yönetim Becerileri"
msgstr "مهارت های مدیریت"

#: .\spor_yonetimi\templates\spor_yonetimi\includes\spor_yonetimi.html:419
msgid "Yönetimin işleyişi hakkında bilgi ve beceriye sahip olurlar"
msgstr "آنها در مورد عملکرد مدیریت دانش و مهارت دارند."

#: .\spor_yonetimi\templates\spor_yonetimi\includes\spor_yonetimi.html:426
