msgstr "روابط قوی با دفاتر طراحی، شرکت های مبلمان و موسسات عمومی."

#: .\ic_mimarlik\templates\ic_mimarlik\includes\ic_mimarlik.html:250
msgid "Sürdürülebilir Tasarım"
msgstr "طراحی پایدار"

