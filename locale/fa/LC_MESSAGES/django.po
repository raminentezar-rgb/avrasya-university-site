msgstr "گروه تغذیه و رژیم غذایی امروز"

#: .\beslenme_diyetetik\templates\beslenme_diyetetik\includes\beslenme_diyetetik.html:102
msgid ""
"Modern eğitim yöntemleri ve sağlık sektörü işbirlikleriyle, toplumun "
"sağlıklı beslenme alışkanlıklarını şekillendiren liderler yetiştirmek için "
"faaliyetlerine devam etmektedir."
msgstr ""
