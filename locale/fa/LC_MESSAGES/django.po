msgid "Malzeme Seçimi"
msgstr "انتخاب مواد"

#: .\insaat_muhendisligi\templates\insaat_muhendisligi\includes\insaat_muhendisligi.html:339
msgid ""
"İnşaat malzemelerinin özelliklerini belirlemek ve uygun malzemeleri seçmek"
msgstr "تعیین خواص مصالح ساختمانی و انتخاب مصالح مناسب"

#: .\insaat_muhendisligi\templates\insaat_muhendisligi\includes\insaat_muhendisligi.html:343
msgid "Mukavemet Hesapları"
msgstr "محاسبات قدرت"

#: .\insaat_muhendisligi\templates\insaat_muhendisligi\includes\insaat_muhendisligi.html:344
msgid "Yapıların mukavemetini ve dayanıklılığını hesaplamak"
msgstr "محاسبه مقاومت و دوام سازه ها"

#: .\insaat_muhendisligi\templates\insaat_muhendisligi\includes\insaat_muhendisligi.html:348
