#: .\makine_muhendisligi\templates\makine_muhendisligi\includes\makine_muhendisligi.html:450
msgid "Sektörel Dağılım"
msgstr "توزیع بخشی"

#: .\insaat_muhendisligi\templates\insaat_muhendisligi\includes\insaat_muhendisligi.html:503
