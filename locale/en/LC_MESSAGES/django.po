msgid "Patoloji Laboratuvar Teknikleri"
msgstr "Pathology Laboratory Techniques"

#: .\patoloji_laboratuar\templates\patoloji_laboratuar\includes\patoloji_laboratuar.html:15
msgid ""
"Avrasya Üniversitesi - Sağlık Alanında Geleceğin Teknikerlerini "
