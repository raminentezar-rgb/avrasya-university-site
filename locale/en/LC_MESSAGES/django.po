msgstr "Security Focus"

#: .\bilisim_guvenligi\templates\bilisim_guvenligi\includes\bilisim_guvenligi.html:310
msgid "Dijital dünyada güvenliği her şeyin önünde tutma"
msgstr "Keeping security above all else in the digital world"

#: .\bilisim_guvenligi\templates\bilisim_guvenligi\includes\bilisim_guvenligi.html:319
#: .\psikoloji\templates\psikoloji\includes\psikoloji.html:387
