#: .\mutercim_tercumanlik\templates\mutercim_tercumanlik\includes\mutercim_tercumanlik.html:408
msgid "Simültane ve ardıl çeviri hizmetleri"
msgstr "Simultaneous and consecutive translation services"

#: .\mutercim_tercumanlik\templates\mutercim_tercumanlik\includes\mutercim_tercumanlik.html:415
msgid "Edebi Çeviri"
msgstr "Literary Translation"

#: .\mutercim_tercumanlik\templates\mutercim_tercumanlik\includes\mutercim_tercumanlik.html:416
msgid "Edebi eserlerin kültürel bağlamda çevirisi"
msgstr "Translation of literary works in cultural context"

#: .\mutercim_tercumanlik\templates\mutercim_tercumanlik\includes\mutercim_tercumanlik.html:423
