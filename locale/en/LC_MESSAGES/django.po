#: .\sosyal_hizmetler\templates\sosyal_hizmetler\includes\sosyal_hizmetler.html:276
msgid "Toplumun her kesimine ulaşarak sosyal hizmet sunmak"
msgstr "Providing social services by reaching all segments of society"

#: .\sosyal_hizmetler\templates\sosyal_hizmetler\includes\sosyal_hizmetler.html:283
