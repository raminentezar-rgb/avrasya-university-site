msgstr "Architecture & Interior Architecture Offices"

#: .\ic_mimarlik\templates\ic_mimarlik\includes\ic_mimarlik.html:400
msgid "Özel tasarım ofisleri"
msgstr "Private design offices"

#: .\ic_mimarlik\templates\ic_mimarlik\includes\ic_mimarlik.html:401
msgid "Büyük ölçekli mimarlık şirketleri"
msgstr "Large-scale architectural companies"

#: .\ic_mimarlik\templates\ic_mimarlik\includes\ic_mimarlik.html:402
