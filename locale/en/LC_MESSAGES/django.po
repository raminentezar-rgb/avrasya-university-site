msgstr "Data Recording"

#: .\radyoterapi\templates\radyoterapi\includes\radyoterapi.html:435
msgid "Hasta verilerinin titizlikle kayıt altına alınması"
msgstr "Meticulous recording of patient data"

#: .\radyoterapi\templates\radyoterapi\includes\radyoterapi.html:442
msgid "Ekip Koordinasyonu"
msgstr "Team Coordination"

#: .\radyoterapi\templates\radyoterapi\includes\radyoterapi.html:443
msgid "Tedavi sürecinin tıbbi ekip ile koordineli yürütülmesi"
msgstr ""
"Carrying out the treatment process in coordination with the medical team"

#: .\radyoterapi\templates\radyoterapi\includes\radyoterapi.html:450
#: .\tibbi_goruntuleme\templates\tibbi_goruntuleme\includes\tibbi_goruntuleme.html:399
