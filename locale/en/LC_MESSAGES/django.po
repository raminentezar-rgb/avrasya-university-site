msgid "Cihaz temini ve satışı"
msgstr "Device supply and sales"

#: .\odyometri\templates\odyometri\includes\odyometri.html:614
msgid "Teknik servis hizmetleri"
msgstr "Technical services"

#: .\odyometri\templates\odyometri\includes\odyometri.html:616
msgid "Kalite standartlarının uygulanması"
