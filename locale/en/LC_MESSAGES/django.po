msgstr "Our department had its first graduates in 2017."

#: .\harita_muhendisligi\templates\harita_muhendisligi\includes\harita_muhendisligi.html:117
msgid "Günümüzde Harita Mühendisliği Bölümü"
msgstr "Department of Surveying Engineering Today"

#: .\harita_muhendisligi\templates\harita_muhendisligi\includes\harita_muhendisligi.html:121
