#: .\insaat_muhendisligi\templates\insaat_muhendisligi\includes\insaat_muhendisligi.html:339
msgid ""
"İnşaat malzemelerinin özelliklerini belirlemek ve uygun malzemeleri seçmek"
msgstr ""
"Determining the properties of construction materials and selecting suitable "
"materials"

#: .\insaat_muhendisligi\templates\insaat_muhendisligi\includes\insaat_muhendisligi.html:343
