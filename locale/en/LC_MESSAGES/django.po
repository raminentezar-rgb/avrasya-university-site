msgid "Projelerin etüd ve uygulamalarını gerçekleştirme"
msgstr "Carrying out studies and implementations of projects"

#: .\harita_muhendisligi\templates\harita_muhendisligi\includes\harita_muhendisligi.html:470
msgid "Bilişim ve bilgi teknolojileri alanlarında yazılım geliştirme"
msgstr ""
"Software development in the fields of informatics and information "
"technologies"

#: .\harita_muhendisligi\templates\harita_muhendisligi\includes\harita_muhendisligi.html:479
msgid "Elektronik ölçme aletlerini kullanma becerisi"
msgstr "Ability to use electronic measuring instruments"

#: .\harita_muhendisligi\templates\harita_muhendisligi\includes\harita_muhendisligi.html:480
msgid "Bilgisayar yazılım ve donanımlarını etkin kullanma"
msgstr "Using computer software and hardware effectively"

#: .\harita_muhendisligi\templates\harita_muhendisligi\includes\harita_muhendisligi.html:481
msgid "Uydu teknikleri ve GPS teknolojisine hakimiyet"
msgstr "Mastery of satellite techniques and GPS technology"

#: .\harita_muhendisligi\templates\harita_muhendisligi\includes\harita_muhendisligi.html:482
