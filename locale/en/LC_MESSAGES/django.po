#: .\tibbi_goruntuleme\templates\tibbi_goruntuleme\includes\tibbi_goruntuleme.html:597
msgid "Özel kanser tedavi merkezleri"
msgstr "Private cancer treatment centers"

#: .\tibbi_goruntuleme\templates\tibbi_goruntuleme\includes\tibbi_goruntuleme.html:607
