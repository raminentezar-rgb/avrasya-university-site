#: .\insaat_muhendisligi\templates\insaat_muhendisligi\includes\insaat_muhendisligi.html:329
msgid "Yapıların tasarım ve analizlerini yapmak"
msgstr "Making design and analysis of structures"

#: .\insaat_muhendisligi\templates\insaat_muhendisligi\includes\insaat_muhendisligi.html:334
msgid "İnşaat projelerinin yönetimini üstlenmek"
msgstr "Undertake the management of construction projects"

#: .\insaat_muhendisligi\templates\insaat_muhendisligi\includes\insaat_muhendisligi.html:338
