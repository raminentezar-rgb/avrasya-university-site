#: .\rekreasyon\templates\rekreasyon\includes\rekreasyon.html:182
msgid "Rekreasyon Programı Misyon ve Vizyonu"
msgstr "Recreation Program Mission and Vision"

#: .\rekreasyon\templates\rekreasyon\includes\rekreasyon.html:200
msgid ""
