msgstr "Working in radiology departments"

#: .\tibbi_goruntuleme\templates\tibbi_goruntuleme\includes\tibbi_goruntuleme.html:575
msgid "MR, CT, ultrason birimlerinde çalışma"
msgstr "Working in MRI, CT, ultrasound units"

#: .\tibbi_goruntuleme\templates\tibbi_goruntuleme\includes\tibbi_goruntuleme.html:576
