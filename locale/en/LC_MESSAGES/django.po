#: .\mutercim_tercumanlik\templates\mutercim_tercumanlik\includes\mutercim_tercumanlik.html:400
msgid "İngilizce-Türkçe arasında yazılı metinlerin çevirisi"
msgstr "Translation of written texts between English and Turkish"

