#| msgid "Öğrenci Kulüpleri"
msgid "İlk Öğrencilerin Kabulü"
msgstr "Admission of First Students"

#: .\harita_muhendisligi\templates\harita_muhendisligi\includes\harita_muhendisligi.html:84
msgid ""
"Harita Mühendisliği bölümümüz için ilk öğrencilerini kabul ettiği yıl "
"olmuştur."
msgstr ""
"It was the year that our Department of Surveying Engineering accepted its "
"first students."

#: .\harita_muhendisligi\templates\harita_muhendisligi\includes\harita_muhendisligi.html:103
