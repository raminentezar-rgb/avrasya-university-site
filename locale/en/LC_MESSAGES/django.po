msgstr ""
"Working as a researcher in the field of Turkish language and literature"

#: .\turk_dili_edebiyati\templates\turk_dili_edebiyati\includes\turk_dili_edebiyati.html:469
#| msgid "Göç Çalışmaları"
msgid "Türkoloji Çalışmaları"
msgstr ""

#: .\turk_dili_edebiyati\templates\turk_dili_edebiyati\includes\turk_dili_edebiyati.html:470
msgid "Türk dili ve kültürü üzerine bilimsel çalışmalar yapma"
msgstr "Conducting scientific studies on Turkish language and culture"

#: .\turk_dili_edebiyati\templates\turk_dili_edebiyati\includes\turk_dili_edebiyati.html:479
msgid "Pedagojik formasyon eğitimi alma imkanı"
msgstr "Opportunity to receive pedagogical formation training"

#: .\turk_dili_edebiyati\templates\turk_dili_edebiyati\includes\turk_dili_edebiyati.html:480
