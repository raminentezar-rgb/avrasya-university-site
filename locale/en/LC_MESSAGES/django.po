#: .\sosyal_hizmetler\templates\sosyal_hizmetler\includes\sosyal_hizmetler.html:299
#| msgid "Sosyal Olanaklar"
msgid "Sosyal Politika"
msgstr ""

#: .\sosyal_hizmet\templates\sosyal_hizmet\includes\sosyal_hizmet.html:456
msgid "Sosyal politika geliştirme, proje yönetimi, araştırma"
msgstr "Social policy development, project management, research"

#: .\sosyal_hizmet\templates\sosyal_hizmet\includes\sosyal_hizmet.html:463
