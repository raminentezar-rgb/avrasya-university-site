#: .\sosyal_hizmet\templates\sosyal_hizmet\includes\sosyal_hizmet.html:577
msgid ""
"Adalet Bakanlığı'na bağlı birimler, cezaevleri, çocuk mahkemeleri ve "
"denetimli serbestlik müdürlükleri"
msgstr ""
"Units affiliated to the Ministry of Justice, prisons, juvenile courts and "
"probation directorates"

#: .\sosyal_hizmet\templates\sosyal_hizmet\includes\sosyal_hizmet.html:579
msgid "Cezaevlerinde sosyal hizmet uygulamaları"
msgstr "Social work practices in prisons"

#: .\sosyal_hizmet\templates\sosyal_hizmet\includes\sosyal_hizmet.html:580
msgid "Çocuk Mahkemeleri"
msgstr "Children's Courts"

#: .\sosyal_hizmet\templates\sosyal_hizmet\includes\sosyal_hizmet.html:581
msgid "Denetimli Serbestlik Müdürlükleri"
msgstr "Probation Offices"

#: .\sosyal_hizmet\templates\sosyal_hizmet\includes\sosyal_hizmet.html:582
msgid "Adli destek ve mağdur hizmetleri"
msgstr "Legal support and victim services"

#: .\sosyal_hizmet\templates\sosyal_hizmet\includes\sosyal_hizmet.html:592
