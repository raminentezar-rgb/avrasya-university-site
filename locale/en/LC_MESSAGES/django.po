#: .\mimari_restorasyon\templates\mimari_restorasyon\includes\mimari_restorasyon.html:286
#: .\saglik_kurumlari\templates\saglik_kurumlari\includes\saglik_kurumlari.html:302
#: .\saglik_yonetimi\templates\saglik_yonetimi\includes\saglik_yonetimi.html:310
#| msgid "Uluslararası Öğrenciler"
msgid "Uluslararası Tanınırlık"
msgstr "International Recognition"

#: .\ic_mimarlik\templates\ic_mimarlik\includes\ic_mimarlik.html:237
msgid ""
"Dünya üniversiteleri ile işbirlikleri, öğrenci ve öğretim üyesi değişimi."
msgstr "Collaborations with world universities, student and faculty exchange."

#: .\ic_mimarlik\templates\ic_mimarlik\includes\ic_mimarlik.html:243
msgid "Sektörel İşbirlikleri"
msgstr "Sectoral Collaborations"

#: .\ic_mimarlik\templates\ic_mimarlik\includes\ic_mimarlik.html:244
msgid ""
"Tasarım ofisleri, mobilya firmaları ve kamu kurumları ile güçlü bağlar."
msgstr ""
"Strong ties with design offices, furniture companies and public "
"institutions."

#: .\ic_mimarlik\templates\ic_mimarlik\includes\ic_mimarlik.html:250
msgid "Sürdürülebilir Tasarım"
msgstr "Sustainable Design"

#: .\ic_mimarlik\templates\ic_mimarlik\includes\ic_mimarlik.html:251
msgid ""
"Çevre dostu, ergonomik ve yenilikçi malzeme kullanımını teşvik eden "
"projeler."
msgstr ""
"Projects that encourage the use of environmentally friendly, ergonomic and "
"innovative materials."

#: .\ic_mimarlik\templates\ic_mimarlik\includes\ic_mimarlik.html:258
msgid "Türkiye'de iç mimarlık eğitiminde öncü ve belirleyici rol oynamak."
msgstr ""
"To play a pioneering and decisive role in interior architecture education in"
" Türkiye."

#: .\ic_mimarlik\templates\ic_mimarlik\includes\ic_mimarlik.html:267
#: .\insaat_teknolojisi\templates\insaat_teknolojisi\includes\insaat_teknolojisi.html:751
