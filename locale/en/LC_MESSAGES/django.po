#: .\cocuk_gelisimi_programi\templates\cocuk_gelisimi_programi\includes\cocuk_gelisimi_programi.html:354
msgid "Dijital çağın gerekliliklerine uyum sağlayabilen uzmanlar"
msgstr "Experts who can adapt to the requirements of the digital age"

