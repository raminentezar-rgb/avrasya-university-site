#: .\psikoloji\templates\psikoloji\includes\psikoloji.html:324
msgid "Toplum sorunlarına duyarlı bireyler yetiştirme"
msgstr "Raising individuals who are sensitive to social problems"

#: .\psikoloji\templates\psikoloji\includes\psikoloji.html:332
