#: .\harita_muhendisligi\templates\harita_muhendisligi\includes\harita_muhendisligi.html:453
#: .\moda_tasarimi\templates\moda_tasarimi\includes\moda_tasarimi.html:780
msgid "Teknik Altyapı"
msgstr "Technical Infrastructure"

#: .\harita_muhendisligi\templates\harita_muhendisligi\includes\harita_muhendisligi.html:454
msgid "Su, kanal, gaz, telefon, elektrik tesisleri haritası oluşturma"
msgstr ""
"Creating a map of water, canal, gas, telephone and electrical facilities"

