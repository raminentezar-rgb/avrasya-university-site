#: .\turk_dili_edebiyati\templates\turk_dili_edebiyati\includes\turk_dili_edebiyati.html:446
msgid "Pedagojik formasyon ile Türk Dili ve Edebiyatı öğretmenliği"
msgstr "Teaching Turkish Language and Literature with pedagogical formation"

#: .\turk_dili_edebiyati\templates\turk_dili_edebiyati\includes\turk_dili_edebiyati.html:454
msgid "Araştırma görevlisi, okutman veya akademisyen olarak çalışma"
msgstr "Working as a research assistant, lecturer or academician"

#: .\turk_dili_edebiyati\templates\turk_dili_edebiyati\includes\turk_dili_edebiyati.html:461
