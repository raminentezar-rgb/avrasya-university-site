msgstr "Restoration Works"

#: .\mimari_restorasyon\templates\mimari_restorasyon\includes\mimari_restorasyon.html:446
msgid "Binalarda restorasyon, yenileme, onarım ve tadilat işlemleri"
msgstr ""
"Restoration, renovation, repair and alteration operations in buildings"

#: .\mimari_restorasyon\templates\mimari_restorasyon\includes\mimari_restorasyon.html:453
msgid "Personel Denetimi"
msgstr "Personnel Audit"

#: .\mimari_restorasyon\templates\mimari_restorasyon\includes\mimari_restorasyon.html:454
