msgstr "Elderly and Disabled"

#: .\sosyal_hizmet\templates\sosyal_hizmet\includes\sosyal_hizmet.html:440
msgid "Yaşlı bakımı, engelli rehabilitasyonu, sosyal entegrasyon"
msgstr "Elderly care, disabled rehabilitation, social integration"

#: .\sosyal_hizmet\templates\sosyal_hizmet\includes\sosyal_hizmet.html:447
msgid "Kadın ve Toplumsal Cinsiyet"
msgstr "Women and Gender"

#: .\sosyal_hizmet\templates\sosyal_hizmet\includes\sosyal_hizmet.html:448
msgid "Kadın sığınma evleri, toplumsal cinsiyet eşitliği çalışmaları"
msgstr "Women's shelters, gender equality studies"

