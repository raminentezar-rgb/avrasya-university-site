msgstr "Administrative justice judgeship"

#: .\siyaset_bilimi\templates\siyaset_bilimi\includes\siyaset_bilimi.html:578
msgid "Sayıştay ve Danıştay'da uzmanlık"
msgstr "Expertise in the Court of Accounts and the Council of State"

#: .\siyaset_bilimi\templates\siyaset_bilimi\includes\siyaset_bilimi.html:591
msgid ""
"Uluslararası örgütlerde politika analisti ve uzman olarak çalışabilirler."
msgstr ""
"They can work as policy analysts and experts in international organizations."

#: .\siyaset_bilimi\templates\siyaset_bilimi\includes\siyaset_bilimi.html:593
msgid "Birleşmiş Milletler kuruluşları"
msgstr "United Nations organizations"

#: .\siyaset_bilimi\templates\siyaset_bilimi\includes\siyaset_bilimi.html:594
