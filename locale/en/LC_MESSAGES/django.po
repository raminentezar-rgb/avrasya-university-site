#: .\acil_durum\templates\acil_durum\includes\acil_durum.html:225
msgid "Risk azaltma ve güvenlik kültürü çalışmalarını ön planda tutmak"
msgstr "Prioritizing risk reduction and security culture studies"

#: .\acil_durum\templates\acil_durum\includes\acil_durum.html:234
msgid "İletişim ve Karar Alma"
msgstr "Communication and Decision Making"

#: .\acil_durum\templates\acil_durum\includes\acil_durum.html:235
msgid "Baskı altında bilimsel ve doğru kararlar alabilen uzmanlar yetiştirmek"
