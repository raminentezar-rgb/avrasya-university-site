msgstr "To train researchers and innovative information security experts"

#: .\bilisim_guvenligi\templates\bilisim_guvenligi\includes\bilisim_guvenligi.html:229
msgid "Akademik ve Sektörel Altyapı"
msgstr "Academic and Sectoral Infrastructure"

#: .\bilisim_guvenligi\templates\bilisim_guvenligi\includes\bilisim_guvenligi.html:230
