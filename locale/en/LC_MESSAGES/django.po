#: .\tibbi_goruntuleme\templates\tibbi_goruntuleme\includes\tibbi_goruntuleme.html:591
msgid ""
"Özel hastaneler, tıp merkezleri, tanı merkezleri ve özel polikliniklerde "
"çalışabilirler."
msgstr ""
"They can work in private hospitals, medical centers, diagnostic centers and "
"private polyclinics."

#: .\tibbi_goruntuleme\templates\tibbi_goruntuleme\includes\tibbi_goruntuleme.html:593
msgid "Özel görüntüleme merkezlerinde istihdam"
msgstr "Employment in private imaging centers"

#: .\tibbi_goruntuleme\templates\tibbi_goruntuleme\includes\tibbi_goruntuleme.html:594
msgid "Check-up ve tanı merkezlerinde çalışma"
