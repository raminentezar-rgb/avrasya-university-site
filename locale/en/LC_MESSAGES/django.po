msgstr ""
"Translation training in many fields such as law, economics, medicine and "
"technical subjects"

#: .\mutercim_tercumanlik\templates\mutercim_tercumanlik\includes\mutercim_tercumanlik.html:238
msgid "İş Dünyası Odaklı"
msgstr "Business Focused"

#: .\mutercim_tercumanlik\templates\mutercim_tercumanlik\includes\mutercim_tercumanlik.html:239
msgid "İş dünyası ve AB beklentilerine uygun çevirmenler yetiştirmek"
