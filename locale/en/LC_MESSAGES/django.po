msgid "Bakanlıklar"
msgstr "Ministries"

#: .\sosyal_hizmetler\templates\sosyal_hizmetler\includes\sosyal_hizmetler.html:563
msgid ""
"Aile ve Sosyal Politikalar Bakanlığı'na bağlı bütün birimlerde, Sağlık "
"Bakanlığı'na bağlı hastanelerde, Adalet Bakanlığı'na bağlı kurumlarda "
"çalışabilirler."
msgstr ""
