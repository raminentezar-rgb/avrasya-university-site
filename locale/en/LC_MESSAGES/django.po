msgstr "Positioning"

#: .\radyoterapi\templates\radyoterapi\includes\radyoterapi.html:389
msgid "Anatomik bölgeye uygun milimetrik pozisyonlandırma yapmak"
msgstr "Making millimetric positioning appropriate to the anatomical region"

#: .\radyoterapi\templates\radyoterapi\includes\radyoterapi.html:396
#| msgid "Yönetim"
