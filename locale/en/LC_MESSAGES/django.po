msgstr "Controlling the work of masters, journeymen and technicians"

#: .\mimari_restorasyon\templates\mimari_restorasyon\includes\mimari_restorasyon.html:461
msgid "Farklı Sektörler"
msgstr "Different Sectors"

#: .\mimari_restorasyon\templates\mimari_restorasyon\includes\mimari_restorasyon.html:462
msgid "Kamu kurumları, özel sektör veya proje bazlı çalışma"
msgstr "Public institutions, private sector or project-based work"

#: .\mimari_restorasyon\templates\mimari_restorasyon\includes\mimari_restorasyon.html:469
#| msgid "Araştırma"
