msgstr "Medication Management"

#: .\eczane\templates\eczane\includes\eczane.html:400
msgid ""
"Reçeteli ve reçetesiz ilaçların temini, saklanması ve sunumunda eczacıya "
"yardım"
msgstr ""
"Assisting the pharmacist in the supply, storage and presentation of "
"prescription and non-prescription drugs"

#: .\eczane\templates\eczane\includes\eczane.html:407
msgid "Stok Kontrolü"
msgstr "Stock Control"

#: .\eczane\templates\eczane\includes\eczane.html:408
msgid "Ürünlerin son kullanma tarihleri ve stok kontrollerini yapma"
msgstr "Checking expiration dates and stock of products"

#: .\eczane\templates\eczane\includes\eczane.html:415
