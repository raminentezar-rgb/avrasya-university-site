msgstr "Ethical Responsibility"

#: .\bilisim_guvenligi\templates\bilisim_guvenligi\includes\bilisim_guvenligi.html:320
msgid "Bilişim güvenliğinde etik değerlere bağlılık"
msgstr "Adherence to ethical values ​​in information security"

